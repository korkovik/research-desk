{
  "name": "research-desk",
  "version": "0.1.0",
  "description": "Five newly published research papers a day, explained in plain Czech for readers with no scientific background.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "research-desk": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "run:daily": "tsx src/cli.ts run",
    "run:dry": "tsx src/cli.ts run --dry-run",
    "resolve:categories": "tsx scripts/resolve-categories.ts",
    "render:index": "tsx src/cli.ts reindex",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "qa:live-verifier": "tsx scripts/qa-live-verifier.ts",
    "qa:live-sources": "tsx scripts/qa-live-sources.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "fast-xml-parser": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
