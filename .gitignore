node_modules/
dist/
*.tsbuildinfo
.DS_Store

# Deny everything env-shaped, then re-admit the documentation file. A narrower
# pattern lets copies through: a backup like .env.local.bak holds the same key
# as the original, and no secret may reach git.
.env*
!.env.example

# Run output. The archive is the product, but it is machine-generated, and
# committing it would make every daily run a repository change. The repository
# is the code; the archive is what the code makes.
#
# state/seen.json is ignored too, and that is the one to think about: it is the
# only record of what has already been published, so losing it means published
# papers can reappear. It is not in git because a daily-changing file does not
# belong in a code repository — it is on disk, and assumption A1 asks for the
# Mac mini's backup to include it.
archive/*.html
archive/*.json
logs/*.log
state/*.json

# Scratch output for local previewing. Never a deliverable.
tmp/
